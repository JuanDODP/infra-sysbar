# Generado por Ansible en {{ inventory_hostname }}. No editar a mano.
PORT={{ app_port }}

# Base de datos (RDS compartida por todos los servidores)
DB_HOST={{ rds_host }}
DB_PORT={{ rds_port }}
DB_NAME={{ db_name }}
DB_USERNAME={{ db_user }}
DB_PASSWORD={{ db_password }}

# Redis (adaptador de Socket.IO entre servidores)
REDIS_HOST={{ redis_host }}
REDIS_PORT={{ redis_port }}
REDIS_URL={{ ('redis://' ~ redis_host ~ ':' ~ redis_port) if redis_host else '' }}

# Identificador del servidor (útil en logs)
INSTANCE_NAME={{ inventory_hostname }}

{% for key, value in (app_extra_env | default({})).items() %}
{{ key }}={{ value }}
{% endfor %}
