# Este archivo lo genera Terraform automáticamente como inventory.ini.
# Ejemplo de cómo se ve:
[webservers]
sysranchito-dev-ec2-1 ansible_host=X.X.X.1 private_ip=172.31.0.10
sysranchito-dev-ec2-2 ansible_host=X.X.X.2 private_ip=172.31.16.10
sysranchito-dev-ec2-3 ansible_host=X.X.X.3 private_ip=172.31.32.10

[webservers:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/YOUR_KEY.pem
ansible_ssh_common_args='-o ForwardAgent=yes -o StrictHostKeyChecking=accept-new'
