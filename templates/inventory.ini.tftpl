# Generado por Terraform (ansible_inventory.tf). No editar a mano.
[webservers]
%{ for h in hosts ~}
${h.name} ansible_host=${h.public_ip} private_ip=${h.private_ip}
%{ endfor ~}

[webservers:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=${ssh_private_key_path}
# ForwardAgent permite clonar repos privados con tu llave de GitHub sin copiarla al servidor
ansible_ssh_common_args='-o ForwardAgent=yes -o StrictHostKeyChecking=accept-new'
