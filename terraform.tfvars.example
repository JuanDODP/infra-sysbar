# Configuración General de AWS
aws_region  = "us-east-1"
aws_profile = "TU_PERFIL_AWS" # perfil de AWS CLI (ej. el creado con: aws configure sso)
project     = "sysranchito"
environment = "dev"
domain_name = "tu-subdominio.duckdns.org"

# EC2
instance_count       = 3
instance_type        = "t3.micro"            # mínima viable para Docker + NestJS
key_name             = "YOUR_SSH_KEY_NAME"       # Nombre del Key Pair en EC2 (sin .pem)
ssh_private_key_path = "~/.ssh/YOUR_SSH_KEY.pem" # Ruta local a la llave privada
ssh_allowed_cidrs    = ["0.0.0.0/0"]             # Recomendado: ["TU_IP_PUBLICA/32"]  (curl ifconfig.me)

# Balanceadores / WebSockets
lb_idle_timeout        = 3600 # segundos que una conexión WebSocket inactiva sigue abierta
health_check_path      = "/api/health" # GET /api/health de NestJS
health_check_matcher   = "200"
enable_sticky_sessions = true

# Redis para sincronizar Socket.IO entre servidores
enable_redis    = true
redis_node_type = "cache.t4g.micro"

# Variables para la Base de Datos (AWS RDS PostgreSQL)
db_name     = "sysranchitodb"
db_user     = "postgres"
db_password = "CHANGE_ME_SECURE_PASSWORD" # Cambiar por una contraseña segura
